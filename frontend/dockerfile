# Build stage
FROM node:20-alpine AS build

WORKDIR /app

# Copy package files first for better caching
COPY package*.json ./

# Install dependencies
RUN npm ci

# Copy the rest of the application
COPY . .

# Build with placeholder values (will be replaced at runtime)
ENV VITE_HOST_URL=__VITE_HOST_URL__
ENV VITE_PORT_BACKEND_SQL=__VITE_PORT_BACKEND_SQL__
ENV VITE_PORT_BACKEND_STANDARD=__VITE_PORT_BACKEND_STANDARD__
ENV VITE_BASE_URL=__VITE_BASE_URL__
# Vite needs a larger heap on small VMs
ENV NODE_OPTIONS=--max-old-space-size=2048

RUN npm run build

# Production stage
FROM node:20-alpine

WORKDIR /app

# Install serve for static file serving
RUN npm install -g serve

# Copy built assets from build stage
COPY --from=build /app/dist ./dist

# Copy the entrypoint script and fix Windows line endings (CRLF -> LF)
COPY docker-entrypoint.sh /docker-entrypoint.sh
RUN sed -i 's/\r$//' /docker-entrypoint.sh && chmod +x /docker-entrypoint.sh

# Expose the port
EXPOSE 5173

# Use entrypoint to inject env vars at runtime
ENTRYPOINT ["/docker-entrypoint.sh"]
CMD ["serve", "-s", "dist", "-l", "5173"]
