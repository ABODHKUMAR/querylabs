# ============================================================================
# Query Labs Deployment Environment Variables
# ============================================================================
# Copy this file to .env.deploy and fill in your values
# Then source it before running deploy-to-vm.sh:
#   source .env.deploy
#   ./deploy-to-vm.sh
# ============================================================================

# ----------------------
# Required Variables
# ----------------------

# OpenAI Configuration
export OPENAI_API_KEY="sk-..."  # Your OpenAI API key

# Authentication (MUST match across all services)
export SECRET_KEY="querylab-change-me-secret"  # Same as your local deployment

# Backend Database Password (for user authentication in querylab_auth database)
export BACKEND_DB_PASSWORD="querylab_pass"  # matches local Docker MySQL

# Weaviate Configuration
export WEAVIATE_API_KEY="your_weaviate_api_key_here"

# ----------------------
# Optional Variables
# ----------------------

# VM Configuration (defaults shown)
export VM_USER="$(whoami)"  # SSH username for VM
export VM_IP="15.207.111.124"  # Your personal VM
export GIT_BRANCH="main"  # Git branch to deploy

# Langsmith (for LLM observability - optional)
export LANGSMITH_TRACING="true"
export LANGSMITH_ENDPOINT="https://api.smith.langchain.com"
export LANGSMITH_API_KEY="lsv2_pt_..."  # Your Langsmith API key
export LANGSMITH_PROJECT="querylab-prod"

# Backend Database — local Docker MySQL (service name: mysql)
export BACKEND_DB_HOST="mysql"
export BACKEND_DB_USER="querylab"
export BACKEND_DB_DATABASE="querylab_auth"
export BACKEND_DB_PORT="3306"

# Revenue MCP (financial_metrics database)
export REVENUE_MYSQL_HOST="mysql"
export REVENUE_MYSQL_PORT="3306"
export REVENUE_MYSQL_USER="querylab"
export REVENUE_MYSQL_PASSWORD="${BACKEND_DB_PASSWORD}"
export REVENUE_MYSQL_DATABASE="financial_metrics"

# Beat MCP (beat_results_dev database)
export BEAT_MYSQL_HOST="mysql"
export BEAT_MYSQL_PORT="3306"
export BEAT_MYSQL_USER="querylab"
export BEAT_MYSQL_PASSWORD="${BACKEND_DB_PASSWORD}"
export BEAT_MYSQL_DATABASE="beat_results_dev"

# Meridian MCP (meridian_ventures database)
export MERIDIAN_MYSQL_HOST="mysql"
export MERIDIAN_MYSQL_PORT="3306"
export MERIDIAN_MYSQL_USER="querylab"
export MERIDIAN_MYSQL_PASSWORD="${BACKEND_DB_PASSWORD}"
export MERIDIAN_MYSQL_DATABASE="meridian_ventures"

# Weaviate Configuration — local Docker (service name: weaviate)
export WEAVIATE_HOST="weaviate"
export WEAVIATE_PORT="8080"
export WEAVIATE_API_KEY="querylab-weaviate-key"

# ----------------------
# Usage Example
# ----------------------
# 1. Copy this file: cp env.template .env.deploy
# 2. Edit .env.deploy with your actual values
# 3. Source it: source .env.deploy
# 4. Deploy: ./deploy-to-vm.sh
